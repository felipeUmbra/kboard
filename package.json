{
  "name": "kboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trello-inspired Kanban board with Google OAuth + Google Drive storage",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:regression": "playwright test tests/regression/",
    "test:regression:debug": "playwright test tests/regression/ --debug",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-tablet --project=chromium-mobile --project=pwa",
    "test:e2e:axe": "playwright test tests/e2e/a11y-axe.spec.ts --project=chromium-desktop",
    "test:e2e:crossbrowser": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:unit:coverage:check": "vitest run --coverage",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium-desktop",
    "test:e2e:subpath": "node scripts/test-subpath.mjs",
    "test:e2e:report": "playwright show-report",
    "a11y:contrast": "node scripts/check-contrast.js",
    "lint:colors": "node scripts/lint-color-literals.js",
    "a11y": "npm run a11y:contrast && npm run lint:colors",
    "a11y:axe": "playwright test tests/e2e/a11y-axe.spec.ts --project=chromium-desktop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "date-fns": "^3.6.0",
    "dompurify": "^3.1.6",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.33.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^1.6.1"
  }
}
